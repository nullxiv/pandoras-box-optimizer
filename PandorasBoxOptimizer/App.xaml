<Application x:Class="PandorasBoxOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>

      <!-- Brand fonts from the Pandora's Box site -->
      <FontFamily x:Key="Display">pack://application:,,,/assets/#Bricolage Grotesque</FontFamily>
      <FontFamily x:Key="Body">pack://application:,,,/assets/#Manrope</FontFamily>
      <FontFamily x:Key="BodyMed">pack://application:,,,/assets/#Manrope Medium</FontFamily>
      <FontFamily x:Key="BodySemi">pack://application:,,,/assets/#Manrope SemiBold</FontFamily>
      <FontFamily x:Key="BodyBold">pack://application:,,,/assets/#Manrope Bold</FontFamily>

      <!-- Palette (site tokens: page #0a0b0d, brand #3b82f6, ink #f2f2f5) -->
      <SolidColorBrush x:Key="Page"   Color="#FF0A0B0D"/>
      <SolidColorBrush x:Key="Card"   Color="#FF121318"/>
      <SolidColorBrush x:Key="CardHover" Color="#FF16181F"/>
      <SolidColorBrush x:Key="Line"   Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="Ink"    Color="#FFF2F2F5"/>
      <SolidColorBrush x:Key="Muted"  Color="#FF94A3B8"/>
      <SolidColorBrush x:Key="Faint"  Color="#FF64748B"/>
      <SolidColorBrush x:Key="Brand"  Color="#FF3B82F6"/>
      <Color x:Key="BrandColor">#FF3B82F6</Color>

      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyBold}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="9" Background="{StaticResource Brand}" Padding="20,12">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF2563EB"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.3"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="LinkBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyMed}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" Padding="4,2"><ContentPresenter VerticalAlignment="Center"/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
