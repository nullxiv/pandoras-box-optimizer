<Window x:Class="PandorasBoxOptimizer.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora's Box" Height="470" Width="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Page}" FontFamily="{StaticResource Body}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
  <Grid Margin="34,28,34,26">
    <StackPanel VerticalAlignment="Center">

      <!-- brand -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Viewbox Width="29" Height="29" VerticalAlignment="Center">
          <Canvas Width="512" Height="512">
            <Path Fill="{StaticResource Ink}" Data="M112 160 180 94H328L424 192H327L272 141H232L174 200V244L228 298H112Z"/>
            <Path Fill="{StaticResource Ink}" Data="M112 160 180 94H328L424 192H327L272 141H232L174 200V244L228 298H112Z">
              <Path.RenderTransform><RotateTransform Angle="180" CenterX="256" CenterY="256"/></Path.RenderTransform>
            </Path>
          </Canvas>
        </Viewbox>
        <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Display}"
                   FontSize="21" Foreground="{StaticResource Ink}"><Run Text="Pandora's "/><Run Text="Box" Foreground="#FF67A7FF"/></TextBlock>
      </StackPanel>
      <TextBlock Text="FPS Optimizer" HorizontalAlignment="Center" Margin="0,6,0,0"
                 Foreground="{StaticResource Faint}" FontSize="12" FontFamily="{StaticResource BodyMed}"/>

      <!-- checking state -->
      <StackPanel x:Name="Checking" Margin="0,30,0,0" Visibility="Collapsed">
        <TextBlock Text="Checking your access…" HorizontalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontFamily="{StaticResource BodySemi}" FontSize="13"/>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,13,0,0" BorderThickness="0"
                     Background="#22FFFFFF" Foreground="{StaticResource Brand}"/>
      </StackPanel>

      <!-- entry state -->
      <StackPanel x:Name="Entry" Margin="0,26,0,0" Visibility="Collapsed">
        <TextBlock Text="Enter your access code" HorizontalAlignment="Center"
                   Foreground="{StaticResource Ink}" FontFamily="{StaticResource BodySemi}" FontSize="14"/>

        <Border Margin="0,14,0,0" CornerRadius="9" Background="#FF0E1015"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="2">
          <TextBox x:Name="CodeBox" BorderThickness="0" Background="Transparent"
                   Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Brand}"
                   FontFamily="{StaticResource BodySemi}" FontSize="16" MaxLength="20"
                   CharacterCasing="Upper" Padding="12,11" TextAlignment="Center"
                   KeyDown="OnKeyDown"/>
        </Border>
        <TextBlock Text="Format: PBX-XXXXX-XXXXX" HorizontalAlignment="Center"
                   Foreground="{StaticResource Faint}" FontSize="10.5" Margin="0,7,0,0"/>

        <TextBlock x:Name="ErrText" HorizontalAlignment="Center" Foreground="#FFF2616B"
                   FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

        <Button x:Name="BtnActivate" Content="Activate" Style="{StaticResource Primary}"
                Margin="0,14,0,0" Click="OnActivate"/>

        <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                   Foreground="{StaticResource Faint}" FontSize="11" TextAlignment="Center"
                   Text="Get a code from the Pandora's Box Discord."/>
      </StackPanel>

    </StackPanel>
  </Grid>
</Window>
