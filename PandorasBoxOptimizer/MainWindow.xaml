<Window x:Class="PandorasBoxOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pandora's Box" Height="452" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource Page}" FontFamily="{StaticResource Body}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Brand row -->
    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Viewbox Width="27" Height="27" VerticalAlignment="Center">
          <Canvas Width="512" Height="512">
            <Path Fill="{StaticResource Ink}" Data="M112 160 180 94H328L424 192H327L272 141H232L174 200V244L228 298H112Z"/>
            <Path Fill="{StaticResource Ink}" Data="M112 160 180 94H328L424 192H327L272 141H232L174 200V244L228 298H112Z">
              <Path.RenderTransform><RotateTransform Angle="180" CenterX="256" CenterY="256"/></Path.RenderTransform>
            </Path>
          </Canvas>
        </Viewbox>
        <TextBlock Margin="11,0,0,0" VerticalAlignment="Center"
                   FontFamily="{StaticResource Display}" FontSize="20.5" Foreground="{StaticResource Ink}">
          <TextBlock.LayoutTransform><ScaleTransform ScaleX="0.95"/></TextBlock.LayoutTransform><Run Text="Pandora's "/><Run Text="Box" Foreground="#FF67A7FF"/></TextBlock>
      </StackPanel>
      <TextBlock Text="Modern Warfare IV" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Foreground="{StaticResource Faint}" FontSize="11.5" FontFamily="{StaticResource BodyMed}"/>
    </Grid>

    <Border Grid.Row="1" Height="1" Background="{StaticResource Line}" Margin="0,18,0,0"/>

    <!-- Scan / system panel -->
    <Border Grid.Row="2" Margin="0,16,0,0" CornerRadius="10"
            Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            Padding="14,12" MinHeight="58">
      <Grid>
        <!-- scanning state -->
        <StackPanel x:Name="ScanState" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Brand}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ScanLabel" Margin="9,0,0,0" Text="Scanning your system…"
                       Foreground="{StaticResource Ink}" FontFamily="{StaticResource BodySemi}" FontSize="12.5"/>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,9,0,0" BorderThickness="0"
                       Background="#22FFFFFF" Foreground="{StaticResource Brand}"/>
        </StackPanel>

        <!-- result state -->
        <Grid x:Name="ResultState" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="LblYourPc" Text="YOUR PC" Foreground="{StaticResource Faint}" FontFamily="{StaticResource BodyBold}" FontSize="9"/>
            <TextBlock x:Name="SpecGpu" Margin="0,3,0,0" Foreground="{StaticResource Ink}"
                       FontFamily="{StaticResource BodySemi}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SpecSub" Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="11.5"/>
          </StackPanel>
          <Border x:Name="RecoPill" Grid.Column="1" VerticalAlignment="Center" CornerRadius="7"
                  Background="#143B82F6" BorderBrush="#4D3B82F6" BorderThickness="1" Padding="10,6">
            <TextBlock x:Name="RecoText" Foreground="#FF9CC3FF" FontFamily="{StaticResource BodyBold}" FontSize="10.5"/>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <!-- Profile cards (built in code-behind) -->
    <UniformGrid x:Name="CardsPanel" Grid.Row="3" Columns="2" Margin="0,12,0,0"/>

    <!-- Apply -->
    <Button x:Name="BtnApply" Grid.Row="4" Style="{StaticResource Primary}"
            Content="Apply" Margin="0,16,0,0" Click="OnApply"/>

    <!-- Footer row: status + restore -->
    <Grid Grid.Row="5" Margin="0,13,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Faint}"
                 FontSize="11.5" TextTrimming="CharacterEllipsis"
                 Text="Backs up your current settings first."/>
      <Button x:Name="BtnRestore" HorizontalAlignment="Right" Style="{StaticResource LinkBtn}"
              Content="Restore backup" Click="OnRestore"/>
    </Grid>
  </Grid>
</Window>
